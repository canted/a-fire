# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

**/.DS_Store
# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates).
/.env*
!/.env*.erb
!/.env*.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/frontend/*
/public/site/*
/public/assets
/public/assets.json

/dist/*
/storybook-static/
/plan

# Ignore master key for decrypting credentials and more.
/config/master.key

/node_modules
/frontend/node_modules/
/frontend/.expo/
/frontend/dist/
/frontend/ios/
/frontend/android/
/frontend/expo-env.d.ts
/frontend/.env*
!/frontend/.env.example
/digital-ocean-rails-template

# SQLite database files
/db/*.sqlite3
/db/*.sqlite3-*

.DS_Store
/app/assets/builds/*
!/app/assets/builds/.keep

/vendor/icons

/.tanstack
/.pnpm-store
tests/e2e/reports/
tests/e2e/.auth/
/coverage
.impeccable
.agents/skills/impeccable/scripts/bin/
debug-storybook.log

# Private deployment configuration and local tool caches
/.docker/
/.prisma/
/fly*.toml
/server/prisma/inventory/
