{
  "name": "afire",
  "version": "0.0.1",
  "main": "index.js",
  "repository": "https://github.com/canted/a-fire.git",
  "author": "William Kingston Davies",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "scripts": {
    "dev": "./bin/dev",
    "dev:site": "VITE_BUILD_TARGET=site vite",
    "dev:api": "TSX_DISABLE_IPC=1 tsx --tsconfig tsconfig.server.json server/main.ts",
    "dev:worker": "TSX_DISABLE_IPC=1 tsx --tsconfig tsconfig.server.json server/scripts/worker.ts",
    "b": "pnpm build",
    "build": "pnpm run build:app && pnpm run build:site && pnpm run build:api",
    "build:api": "rm -rf dist && tsup",
    "build:app": "./bin/build:app",
    "build:site": "./bin/build:site",
    "console": "pnpm tsx --tsconfig tsconfig.server.json server/scripts/repl.ts",
    "start:api": "node dist/server/main.js",
    "start:worker": "node dist/server/scripts/worker.js",
    "test": "./bin/test",
    "playwright": "NODE_ENV=test pnpm exec playwright test",
    "playwright:ui": "NODE_ENV=test pnpm exec playwright test --ui",
    "vitest": "pnpm exec vitest run",
    "migrate": "node dist/server/scripts/migrate.js",
    "backfill:post-subjects": "TSX_DISABLE_IPC=1 tsx --tsconfig tsconfig.server.json server/scripts/backfill-post-subjects.ts",
    "backfill:post-subjects:dist": "node dist/server/scripts/backfill-post-subjects.js",
    "reconcile:notification-replies": "node dist/server/scripts/reconcile-notification-replies.js",
    "inspect:image-variants": "node dist/server/scripts/inspect-image-variants.js",
    "repair:image-variants": "node dist/server/scripts/repair-image-variants.js",
    "recover:push-delivery": "node dist/server/scripts/recover-push-delivery.js",
    "recover:media-attempt": "node dist/server/scripts/recover-media-attempt.js",
    "recover:pending-media": "node dist/server/scripts/recover-pending-media.js",
    "inspect:pending-media": "node dist/server/scripts/inspect-pending-media.js",
    "inspect:media-attempts": "node dist/server/scripts/inspect-media-attempts.js",
    "retry:failed-audio": "node dist/server/scripts/retry-failed-audio.js",
    "retry:failed-video": "node dist/server/scripts/retry-failed-video.js",
    "preview": "vite preview",
    "lint": "./bin/lint",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "storybook": "storybook dev -p 6007 -c frontend/.storybook",
    "build-storybook": "storybook build -c frontend/.storybook",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:api && pnpm typecheck:quality",
    "typecheck:app": "tsc --noEmit -p frontend/tsconfig.json",
    "typecheck:api": "tsc --noEmit -p tsconfig.server.build.json",
    "test:prepare": "./bin/test --prepare-only",
    "typecheck:quality": "tsc --noEmit -p tsconfig.quality.json",
    "db:prepare": "TSX_DISABLE_IPC=1 tsx --tsconfig tsconfig.server.json server/scripts/prepare-database.ts",
    "expo:install": "pnpm --dir frontend install --frozen-lockfile",
    "expo:web": "pnpm --dir frontend web",
    "expo:ios": "pnpm --dir frontend ios",
    "expo:android": "pnpm --dir frontend android",
    "expo:tokens": "node bin/expo-tokens.mjs",
    "typecheck:expo": "pnpm --dir frontend typecheck",
    "build:expo": "pnpm --dir frontend build:web",
    "build:expo:all": "pnpm --dir frontend build:all"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hocuspocus/provider": "^3.4.3",
    "@hocuspocus/server": "^3.4.3",
    "@hocuspocus/transformer": "^3.4.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@mui/material": "^9.2.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/websockets": "^11.1.28",
    "@posthog/react": "^1.10.3",
    "@prisma/client": "^6.5.0",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-collaboration": "^3.30.5",
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-mention": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/extension-text-align": "^3.30.5",
    "@tiptap/extension-text-style": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "clsx": "^2.1.1",
    "color": "^5.0.3",
    "dotenv": "^16.6.1",
    "graphql": "^16.12.0",
    "graphql-request": "^7.3.5",
    "mersenne-twister": "^1.1.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.1.4",
    "pg": "8.17.2",
    "pg-boss": "^10.2.3",
    "posthog-js": "^1.414.0",
    "posthog-node": "^5.48.1",
    "prisma": "^6.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "18.3.1",
    "react-router-dom": "^7.18.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "swr": "^2.3.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "y-protocols": "1.0.7",
    "yjs": "^13.6.27",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^9.39.2",
    "@factory-js/factory": "^0.4.1",
    "@factory-js/prisma-factory": "^0.2.2",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^10.2.10",
    "@storybook/addon-docs": "^10.2.10",
    "@storybook/addon-onboarding": "^10.2.10",
    "@storybook/addon-vitest": "^10.2.10",
    "@storybook/react-vite": "^10.2.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.28.1",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "eslint-plugin-storybook": "^10.2.10",
    "fishery": "^2.4.0",
    "globals": "^17.3.0",
    "impeccable": "^4.1.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.26",
    "storybook": "^10.2.10",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.6",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.1.11"
  }
}
