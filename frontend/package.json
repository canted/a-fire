  "scripts": {
    "start": "node --dns-result-order=ipv4first node_modules/expo/bin/cli start --localhost --port 8082",
    "web": "pnpm start --web",
    "ios": "pnpm start --ios --dev-client",
    "android": "pnpm start --android --dev-client",
    "build:web": "expo export --platform web",
    "build:all": "expo export --platform all",
    "typecheck": "tsc --noEmit",
    "check:versions": "EXPO_OFFLINE=1 expo install --check",
    "native:ios": "expo run:ios --port 8082",
    "native:android": "expo run:android --port 8082",
    "styles:generate": "node scripts/generate-tokens.mjs && node scripts/generate-artwork.mjs",
    "styles:check": "node scripts/generate-tokens.mjs --check && node scripts/generate-artwork.mjs --check",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "private": true,
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
