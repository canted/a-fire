# Optional in development: defaults to localhost:4000/api on web/iOS and
# 10.0.2.2:4000/api on the Android emulator. Set a reachable LAN URL for phones.
# Required for deployed builds; use HTTPS.
# EXPO_PUBLIC_API_URL=https://your-api.example/api

# Expo web analytics (public project token; never a PostHog personal API key).
# Release builder also accepts existing VITE_POSTHOG_KEY / VITE_POSTHOG_HOST.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Enable only against a test PostHog project when developing locally.
EXPO_PUBLIC_POSTHOG_ENABLE_IN_DEV=false
