# Disposable local tests only. Copy to .env.test and adjust the local role/password.
# Keep a distinct database whose name contains a test segment. Browser setup
# clears this database. Never point it at development, staging, or production.
NODE_ENV=test
DATABASE_URL=postgresql://afire_local:afire-local-only@127.0.0.1:5432/afire_test?schema=public
JWT_SECRET=afire-test-only-jwt-secret
API_PORT=4100
APP_BASE_URL=http://127.0.0.1:5174

UPLOADS_STORAGE_BACKEND=local
UPLOADS_STORAGE_ROOT=storage/test

# Real browser authentication/invitations still send mail. Run a local SMTP
# catcher at this address; keep production mail credentials out of test files.
BREVO_SMTP_SERVER=127.0.0.1
BREVO_SMTP_PORT=1025
BREVO_SMTP_LOGIN=
BREVO_SMTP_PASSWORD=
BREVO_SENDER=no-reply@example.com

# pnpm test supplies the frontend/API ports and websocket/proxy settings.
# For different ports, export TEST_FRONTEND_PORT and TEST_API_PORT when launching.
