# Local development only. Copy to .env and adjust for your PostgreSQL setup.
# Create this role/database using the README instructions. Never use these
# example credentials or JWT secret for a hosted environment.
NODE_ENV=development
DATABASE_URL=postgresql://afire_local:afire-local-only@127.0.0.1:5432/afire_development?schema=public
JWT_SECRET=afire-development-only-jwt-secret
API_PORT=4000
APP_BASE_URL=http://localhost:5173

# Keep development files separate from disposable test uploads.
UPLOADS_STORAGE_BACKEND=local
UPLOADS_STORAGE_ROOT=storage/development

# Run a local SMTP catcher before using login/invitation flows.
# These are the variable names consumed by MailerService, even for local SMTP.
BREVO_SMTP_SERVER=127.0.0.1
BREVO_SMTP_PORT=1025
BREVO_SMTP_LOGIN=
BREVO_SMTP_PASSWORD=
BREVO_SENDER=no-reply@example.com

# Push notifications, analytics, and S3 are optional for local startup.
# Configure those integrations separately when working on their behavior.
