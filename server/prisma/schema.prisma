generator client {
  provider = "prisma-client-js"
}

generator factory {
  provider = "prisma-factory"
  output   = "../../tests/e2e/factories/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           Int                        @id @default(autoincrement())
  email                        String                     @unique @db.VarChar
  encrypted_password           String                     @default("") @db.VarChar
  reset_password_token         String?                    @db.VarChar
  reset_password_sent_at       DateTime?                  @db.Timestamp(6)
  remember_created_at          DateTime?                  @db.Timestamp(6)
  username                     String                     @db.VarChar
  profile_line                 String?                    @db.VarChar(160)
  created_at                   DateTime                   @map("created_at") @db.Timestamp(6)
  updated_at                   DateTime                   @map("updated_at") @db.Timestamp(6)
  last_seen_at                 DateTime?                  @db.Timestamp(6)
  notify_by_the                Int?
  notified_at                  DateTime?                  @db.Timestamp(6)
  rooms                        Room[]                     @relation("RoomOwner")
  room_visits                  RoomVisit[]
  memberships                  RoomMembership[]
  invites                      Invite[]                   @relation("InviteSender")
  notification_events          NotificationEvent[]        @relation("NotificationActor")
  notification_targets         NotificationEvent[]        @relation("NotificationTarget")
  chat_message_reads           ChatMessageRead[]
  notification_inbox_items     NotificationInboxItem[]
  notification_push_deliveries NotificationPushDelivery[]
  entry_view_states            EntryViewState[]
  round_result_presentations   RoundResultPresentation[]
  notice_cursor                UserNoticeCursor?
  notification_preferences     NotificationPreference[]
  created_introductions        Introduction[]             @relation("IntroductionCreator")
  retracted_introductions      Introduction[]             @relation("IntroductionRetractor")
  introduction_recipients      IntroductionRecipient[]
  tokens                       OneTimeToken[]
  room_banners                 RoomBanner[]               @relation("RoomBannerCreator")
  room_banner_targets          RoomBannerTarget[]
  entries                      Entry[]
  replies                      Reply[]
  reflections                  Reflection[]
  roles                        Role[]
  audio_assets                 AudioAsset[]
  video_assets                 VideoAsset[]
  audio_annotations            AudioAnnotation[]          @relation("AudioAnnotationCreator")
  chat_messages                ChatMessage[]              @relation("ChatMessageAuthor")
  chat_messages_saved          ChatMessage[]              @relation("ChatMessageSaver")
  chat_messages_pinned         ChatMessage[]              @relation("ChatMessagePinner")
  chat_identity_grants         ChatMessageIdentityGrant[]
  chat_presence_sessions       ChatPresenceSession[]
  chat_save_requests_created   ChatSaveRequest[]          @relation("ChatSaveRequestRequester")
  chat_save_requests_received  ChatSaveRequest[]          @relation("ChatSaveRequestOwner")
  room_join_requests           RoomJoinRequest[]          @relation("RoomJoinRequester")
  room_join_requests_reviewed  RoomJoinRequest[]          @relation("RoomJoinReviewer")
  room_invitations_received    RoomMemberInvitation[]     @relation("RoomInvitationRecipient")
  room_invitations_sent        RoomMemberInvitation[]     @relation("RoomInvitationSender")
  room_knocks                  RoomKnock[]                @relation("RoomKnocker")
  room_knocks_reviewed         RoomKnock[]                @relation("RoomKnockReviewer")
  chat_note_copies             ChatNoteCopy[]
  hosted_activities            Round[]                 @relation("ActivityHost")
  activity_participations      ActivityParticipation[]
  activity_submission_records  ActivitySubmission[]
  activity_activity_artifacts  ActivityArtifact[]
  activity_activity_offers     ActivityOffer[]
  activity_activity_moderation ActivityModerationEvent[]  @relation("ActivityModerator")
  owned_projects               Project[]                  @relation("ProjectOwner")
  project_participations       ProjectParticipation[]     @relation("ProjectParticipant")
  project_invitations_sent     ProjectParticipation[]     @relation("ProjectInviter")

  @@map("users")
}

model Room {
  id                     Int                    @id @default(autoincrement())
  name                   String?                @db.VarChar
  owner_id               Int?                   @map("owner_id")
  parent_id              Int?                   @map("parent_id")
  porosity               String                 @default("open") @db.VarChar
  created_at             DateTime               @map("created_at") @db.Timestamp(6)
  updated_at             DateTime               @map("updated_at") @db.Timestamp(6)
  deleted_at             DateTime?              @db.Timestamp(6)
  reply_mode             String                 @default("simple") @db.VarChar
  default_feedback_types Json                   @default("[\"impression\",\"question\",\"idea\"]") @db.Json
  default_idea_guidance  String                 @default("open") @db.VarChar
  owner                  User?                  @relation("RoomOwner", fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent                 Room?                  @relation("RoomTree", fields: [parent_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  children               Room[]                 @relation("RoomTree")
  memberships            RoomMembership[]
  banners                RoomBanner[]
  notification_events    NotificationEvent[]
  introductions          Introduction[]
  invites                Invite[]
  chat_messages          ChatMessage[]
  chat_presence_sessions ChatPresenceSession[]
  rounds             Round[]
  round_results        RoundResult[]
  projects               ProjectRoom[]
  join_requests          RoomJoinRequest[]
  member_invitations     RoomMemberInvitation[]
  knocks                 RoomKnock[]
  visits                 RoomVisit[]

  @@index([parent_id, porosity, id], map: "index_rooms_on_parent_porosity")
  @@map("rooms")
}

model ChatMessage {
  id              Int                        @id @default(autoincrement())
  room_id         Int                        @map("room_id")
  author_id       Int                        @map("author_id")
  saved_by_id     Int?                       @map("saved_by_id")
  pinned_by_id    Int?                       @map("pinned_by_id")
  entry_id        Int?                       @unique(map: "index_chat_messages_on_entry") @map("entry_id")
  status          String                     @default("published") @db.VarChar
  timeline_kind   String                     @default("message") @map("timeline_kind") @db.VarChar
  entry_origin    String?                    @map("entry_origin") @db.VarChar
  saved_at        DateTime?                  @map("saved_at") @db.Timestamp(6)
  pinned_at       DateTime?                  @map("pinned_at") @db.Timestamp(6)
  body            String                     @db.Text
  content         Json?                      @db.Json
  masked_alias    String                     @map("masked_alias") @db.VarChar
  client_nonce    String?                    @map("client_nonce") @db.VarChar(64)
  fire_at         DateTime                   @map("fire_at") @db.Timestamp(6)
  expires_at      DateTime                   @map("expires_at") @db.Timestamp(6)
  created_at      DateTime                   @map("created_at") @db.Timestamp(6)
  updated_at      DateTime                   @map("updated_at") @db.Timestamp(6)
  room            Room                       @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author          User                       @relation("ChatMessageAuthor", fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  saved_by        User?                      @relation("ChatMessageSaver", fields: [saved_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  pinned_by       User?                      @relation("ChatMessagePinner", fields: [pinned_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  entry           Entry?                     @relation(fields: [entry_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replies         Reply[]
  read_receipts   ChatMessageRead[]
  identity_grants ChatMessageIdentityGrant[]
  save_requests   ChatSaveRequest[]
  note_copies     ChatNoteCopy[]

  @@unique([author_id, client_nonce], map: "index_chat_messages_on_author_nonce")
  @@index([room_id, created_at, id], map: "index_chat_messages_on_room_created")
  @@index([room_id, status, pinned_at, id], map: "index_chat_messages_on_room_status_pinned")
  @@index([room_id, expires_at], map: "index_chat_messages_on_room_expires")
  @@map("chat_messages")
}

model ChatMessageRead {
  user_id    Int
  message_id Int
  seen_at    DateTime    @default(now()) @db.Timestamp(6)
  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  message    ChatMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@id([user_id, message_id])
  @@map("chat_message_reads")
}

model ChatMessageIdentityGrant {
  id         Int         @id @default(autoincrement())
  message_id Int         @map("message_id")
  user_id    Int         @map("user_id")
  created_at DateTime    @map("created_at") @db.Timestamp(6)
  message    ChatMessage @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([message_id, user_id], map: "index_chat_identity_grants_on_message_user")
  @@index([user_id, message_id], map: "index_chat_identity_grants_on_user_message")
  @@map("chat_message_identity_grants")
}

model ChatPresenceSession {
  id            Int       @id @default(autoincrement())
  room_id       Int       @map("room_id")
  user_id       Int       @map("user_id")
  connection_id String    @map("connection_id") @db.VarChar
  entered_at    DateTime  @map("entered_at") @db.Timestamp(6)
  last_seen_at  DateTime  @map("last_seen_at") @db.Timestamp(6)
  left_at       DateTime? @map("left_at") @db.Timestamp(6)
  room          Room      @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([room_id, connection_id], map: "index_chat_presence_on_room_connection")
  @@index([room_id, left_at, last_seen_at], map: "index_chat_presence_on_room_active")
  @@index([user_id, left_at], map: "index_chat_presence_on_user_active")
  @@map("chat_presence_sessions")
}

model ChatSaveRequest {
  id           Int         @id @default(autoincrement())
  message_id   Int         @map("message_id")
  requester_id Int         @map("requester_id")
  owner_id     Int         @map("owner_id")
  status       String      @default("pending") @db.VarChar
  created_at   DateTime    @map("created_at") @db.Timestamp(6)
  updated_at   DateTime    @map("updated_at") @db.Timestamp(6)
  message      ChatMessage @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  requester    User        @relation("ChatSaveRequestRequester", fields: [requester_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  owner        User        @relation("ChatSaveRequestOwner", fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([message_id, requester_id], map: "index_chat_save_requests_on_message_requester")
  @@index([owner_id, status, created_at], map: "index_chat_save_requests_on_owner_status")
  @@map("chat_save_requests")
}

model RoomMembership {
  id                    Int       @id @default(autoincrement())
  room_id               Int       @map("room_id")
  user_id               Int       @map("user_id")
  notify                Boolean?  @default(true)
  created_at            DateTime  @map("created_at") @db.Timestamp(6)
  updated_at            DateTime  @map("updated_at") @db.Timestamp(6)
  unseen_started_at     DateTime  @default(now()) @map("unseen_started_at") @db.Timestamp(6)
  username_override     String?   @map("username_override") @db.VarChar
  profile_line_override String?   @map("profile_line_override") @db.VarChar(160)
  disabled              Boolean   @default(false)
  revoked_at            DateTime? @db.Timestamp(6)
  room                  Room      @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                  User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([room_id, user_id], map: "index_room_memberships_on_room_user")
  @@index([room_id, disabled, revoked_at, created_at, id], map: "index_membership_history_seek")
  @@index([user_id, disabled, room_id], map: "index_room_memberships_on_user_active_room")
  @@map("room_memberships")
}

// Source rows preserve every value removed during duplicate reconciliation.
// No live foreign keys: historical evidence must survive later account/Room lifecycle changes.
model RoomMembershipReconciliation {
  id                      Int      @id @default(autoincrement())
  room_id                 Int      @map("room_id")
  user_id                 Int
  canonical_membership_id Int
  source_records          Json
  conflicting_fields      String[]
  review_status           String
  created_at              DateTime @default(now()) @db.Timestamp(6)

  @@unique([room_id, user_id], map: "index_membership_reconciliations_on_room_user")
  @@index([review_status, id], map: "index_membership_reconciliations_on_review_status")
  @@map("room_membership_reconciliations")
}

model RoomJoinRequest {
  id             Int       @id @default(autoincrement())
  room_id        Int       @map("room_id")
  user_id        Int       @map("user_id")
  status         String    @default("pending") @db.VarChar
  reviewed_by_id Int?      @map("reviewed_by_id")
  reviewed_at    DateTime? @map("reviewed_at") @db.Timestamp(6)
  created_at     DateTime  @map("created_at") @db.Timestamp(6)
  updated_at     DateTime  @map("updated_at") @db.Timestamp(6)
  room           Room      @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User      @relation("RoomJoinRequester", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewed_by    User?     @relation("RoomJoinReviewer", fields: [reviewed_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([room_id, user_id], map: "index_room_join_requests_on_room_user")
  @@index([room_id, status, created_at], map: "index_room_join_requests_on_room_status")
  @@map("room_join_requests")
}

model RoomMemberInvitation {
  id            Int       @id @default(autoincrement())
  room_id       Int       @map("room_id")
  user_id       Int       @map("user_id")
  invited_by_id Int       @map("invited_by_id")
  status        String    @default("pending") @db.VarChar
  responded_at  DateTime? @map("responded_at") @db.Timestamp(6)
  created_at    DateTime  @map("created_at") @db.Timestamp(6)
  updated_at    DateTime  @map("updated_at") @db.Timestamp(6)
  room          Room      @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user          User      @relation("RoomInvitationRecipient", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invited_by    User      @relation("RoomInvitationSender", fields: [invited_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([room_id, user_id], map: "index_room_invitations_on_room_user")
  @@index([user_id, status, created_at], map: "index_room_invitations_on_user_status")
  @@map("room_member_invitations")
}

model RoomKnock {
  id             Int       @id @default(autoincrement())
  room_id        Int       @map("room_id")
  user_id        Int       @map("user_id")
  status         String    @default("pending") @db.VarChar
  reviewed_by_id Int?      @map("reviewed_by_id")
  reviewed_at    DateTime? @map("reviewed_at") @db.Timestamp(6)
  created_at     DateTime  @map("created_at") @db.Timestamp(6)
  updated_at     DateTime  @map("updated_at") @db.Timestamp(6)
  room           Room      @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User      @relation("RoomKnocker", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewed_by    User?     @relation("RoomKnockReviewer", fields: [reviewed_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([room_id, user_id], map: "index_room_knocks_on_room_user")
  @@index([room_id, status, created_at], map: "index_room_knocks_on_room_status")
  @@map("room_knocks")
}

model ChatNoteCopy {
  id              Int         @id @default(autoincrement())
  message_id      Int         @map("message_id")
  note_id         Int         @map("note_id")
  copied_by_id    Int         @map("copied_by_id")
  idempotency_key String      @map("idempotency_key") @db.VarChar(96)
  created_at      DateTime    @map("created_at") @db.Timestamp(6)
  message         ChatMessage @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  note            Page        @relation(fields: [note_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  copied_by       User        @relation(fields: [copied_by_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([copied_by_id, idempotency_key], map: "index_chat_note_copies_on_actor_key")
  @@index([message_id, note_id], map: "index_chat_note_copies_on_message_note")
  @@map("chat_note_copies")
}

model RoomBanner {
  id              Int                @id @default(autoincrement())
  room_id         Int                @map("room_id")
  created_by_id   Int                @map("created_by_id")
  kind            String             @db.VarChar
  placement       String             @db.VarChar
  audience_type   String             @map("audience_type") @db.VarChar
  visibility_rule String             @map("visibility_rule") @db.VarChar
  action_type     String             @map("action_type") @db.VarChar
  message         String?            @db.VarChar
  metadata        Json               @default("{}") @db.Json
  starts_at       DateTime?          @map("starts_at") @db.Timestamp(6)
  ends_at         DateTime?          @map("ends_at") @db.Timestamp(6)
  archived_at     DateTime?          @map("archived_at") @db.Timestamp(6)
  created_at      DateTime           @map("created_at") @db.Timestamp(6)
  updated_at      DateTime           @map("updated_at") @db.Timestamp(6)
  room            Room               @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  created_by      User               @relation("RoomBannerCreator", fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targets         RoomBannerTarget[]

  @@index([room_id, kind, archived_at], map: "index_room_banners_on_room_kind_archived")
  @@map("room_banners")
}

model RoomBannerTarget {
  id               Int        @id @default(autoincrement())
  room_banner_id   Int        @map("room_banner_id")
  user_id          Int        @map("user_id")
  message_override String?    @map("message_override") @db.VarChar
  dismissed_at     DateTime?  @map("dismissed_at") @db.Timestamp(6)
  resolved_at      DateTime?  @map("resolved_at") @db.Timestamp(6)
  created_at       DateTime   @map("created_at") @db.Timestamp(6)
  updated_at       DateTime   @map("updated_at") @db.Timestamp(6)
  banner           RoomBanner @relation(fields: [room_banner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user             User       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([room_banner_id, user_id], map: "index_room_banner_targets_on_banner_and_user")
  @@index([user_id, resolved_at], map: "index_room_banner_targets_on_user_resolved")
  @@map("room_banner_targets")
}

model Entry {
  automated_creation Boolean @default(false)

  id                          Int                     @id @default(autoincrement())
  user_id                     Int                     @map("user_id")
  created_at                  DateTime                @map("created_at") @db.Timestamp(6)
  updated_at                  DateTime                @map("updated_at") @db.Timestamp(6)
  status                      String                  @default("draft") @db.VarChar
  format                      String                  @default("mixed_media") @db.VarChar
  format_data                 Json?                   @map("format_data") @db.Json
  room_id                     Int?                    @map("room_id")
  published_at                DateTime?               @map("published_at") @db.Timestamp(6)
  reply_mode                  String?                 @map("reply_mode") @db.VarChar
  requested_feedback_types    Json?                   @map("requested_feedback_types") @db.Json
  idea_guidance               String?                 @map("idea_guidance") @db.VarChar
  feedback_request_customized Boolean                 @default(false) @map("feedback_request_customized")
  round_id                 Int?                    @map("round_id")
  project_id                  Int?                    @map("project_id")
  creation_origin             String?                 @map("creation_origin") @db.VarChar
  project_intent              String?                 @map("project_intent") @db.Text
  project_question            String?                 @map("project_question") @db.Text
  project_lyrics              String?                 @map("project_lyrics") @db.Text
  source_entry_id             Int?                    @map("source_entry_id")
  source_shared_entry_id      Int?                    @map("source_shared_entry_id")
  source_reply_id             Int?                    @map("source_reply_id")
  source_chat_message_id      Int?                    @map("source_chat_message_id")
  source_author_name          String?                 @map("source_author_name") @db.VarChar
  source_room_ids             Json?                   @db.Json
  source_room_id              Int?
  source_author_id            Int?
  room_statement              String?                 @db.Text
  shared_feedback             Json?                   @db.Json
  share_request_key           String?                 @db.VarChar(128)
  creation_request_key        String?                 @db.VarChar(128)
  share_request_fingerprint   String?                 @db.VarChar(64)
  locked                      Boolean                 @default(false)
  notification_events         NotificationEvent[]
  introductions               Introduction[]
  view_states                 EntryViewState[]
  subject                     EntrySubject?
  user                        User                    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  round                    Round?               @relation(fields: [round_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  project                     Project?                @relation(fields: [project_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  chat_message                ChatMessage?
  activity_submissions        ActivityParticipation[] @relation("ActivitySubmittedEntry")
  activity_submission_records ActivitySubmission[]    @relation("ActivitySubmissionEntry")
  activity_activity_artifact  ActivityArtifact?
  replies                     Reply[]
  round_result_entries        RoundResultEntry[]

  @@unique([user_id, share_request_key], map: "index_entries_on_author_share_request")
  @@unique([user_id, creation_request_key], map: "index_entries_on_author_creation_request")
  @@unique([project_id, user_id, source_reply_id], map: "index_entries_on_project_saver_reply")
  @@unique([project_id, user_id, source_chat_message_id], map: "index_entries_on_project_saver_chat_message")
  @@index([room_id, status, published_at, id], map: "index_entries_on_room_status_published")
  // Published Room-copy history uses the partial covering index defined in SQL.
  @@index([user_id, status, published_at, id], map: "index_entries_on_author_publication_seek")
  @@index([user_id, status, published_at, created_at, id], map: "index_entries_on_author_fallback_seek")
  @@index([round_id, status, published_at, id], map: "index_entries_on_round_status_published")
  @@index([project_id, status, published_at, id], map: "index_entries_on_project_status_published")
  @@index([project_id, status, published_at, created_at, id], map: "index_entries_on_project_fallback_seek")
  @@index([source_entry_id, status], map: "index_entries_on_source_entry_status")
  @@map("entries")
}

model Project {
  creation_request_key String?                @db.VarChar(128)
  icon_symbol          String?                @db.VarChar(64)
  icon_color           String?                @db.VarChar(16)
  id                   Int                    @id @default(autoincrement())
  owner_id             Int                    @map("owner_id")
  name                 String                 @db.VarChar(120)
  description          String?                @db.Text
  created_at           DateTime               @map("created_at") @db.Timestamp(6)
  updated_at           DateTime               @map("updated_at") @db.Timestamp(6)
  owner                User                   @relation("ProjectOwner", fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  participations       ProjectParticipation[]
  rooms                ProjectRoom[]
  entries              Entry[]

  @@unique([owner_id, creation_request_key], map: "index_projects_on_owner_creation_request")
  @@index([owner_id, updated_at], map: "index_projects_on_owner_updated")
  @@map("projects")
}

model ProjectRoom {
  project_id Int      @map("project_id")
  room_id    Int      @map("room_id")
  created_at DateTime @map("created_at") @db.Timestamp(6)
  project    Project  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  room       Room     @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([project_id, room_id])
  @@index([room_id, project_id], map: "index_project_rooms_on_room_project")
  @@map("project_rooms")
}

model ProjectParticipation {
  id            Int       @id @default(autoincrement())
  project_id    Int       @map("project_id")
  user_id       Int       @map("user_id")
  invited_by_id Int       @map("invited_by_id")
  status        String    @default("pending") @db.VarChar
  invited_at    DateTime  @map("invited_at") @db.Timestamp(6)
  responded_at  DateTime? @map("responded_at") @db.Timestamp(6)
