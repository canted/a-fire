  updated_at            DateTime                  @map("updated_at") @db.Timestamp(6)
  user                  User                      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notification_event    NotificationEvent         @relation(fields: [notification_event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  push_delivery         NotificationPushDelivery?

  @@unique([notification_event_id, user_id], map: "index_notification_inbox_items_on_event_and_user")
  @@index([user_id, created_at, id], map: "index_notification_inbox_items_on_user_created_id")
  @@index([user_id, seen_at, id], map: "index_notification_inbox_items_on_user_seen_id")
  @@map("notification_inbox_items")
}

model NotificationPushDelivery {
  id                         Int                             @id @default(autoincrement())
  notification_inbox_item_id Int                             @unique @map("notification_inbox_item_id")
  notification_event_id      Int                             @map("notification_event_id")
  user_id                    Int                             @map("user_id")
  state                      String                          @default("scheduled") @db.VarChar
  scheduled_job_id           String?                         @map("scheduled_job_id") @db.VarChar
  due_at                     DateTime                        @map("due_at") @db.Timestamp(6)
  sent_at                    DateTime?                       @map("sent_at") @db.Timestamp(6)
  cancelled_at               DateTime?                       @map("cancelled_at") @db.Timestamp(6)
  skip_reason                String?                         @map("skip_reason") @db.VarChar
  last_error                 String?                         @map("last_error") @db.Text
  created_at                 DateTime                        @map("created_at") @db.Timestamp(6)
  updated_at                 DateTime                        @map("updated_at") @db.Timestamp(6)
  notification_inbox_item    NotificationInboxItem           @relation(fields: [notification_inbox_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  notification_event         NotificationEvent               @relation(fields: [notification_event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                       User                            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  device_attempts            NotificationPushDeviceAttempt[]

  @@index([user_id, state, due_at], map: "index_notification_push_deliveries_on_user_state_due")
  @@index([notification_event_id], map: "index_notification_push_deliveries_on_event")
  @@map("notification_push_deliveries")
}

enum PushDeviceAttemptState {
  started
  sent
  rejected
  invalid
  uncertain
}

/// Durable outcome per destination. Subscription ID is historical; endpoint credentials are never stored here.
model NotificationPushDeviceAttempt {
  id              Int                      @id @default(autoincrement())
  delivery_id     Int
  endpoint_hash   String                   @db.VarChar(64)
  subscription_id Int
  state           PushDeviceAttemptState   @default(started)
  attempt_count   Int                      @default(1)
  started_at      DateTime                 @db.Timestamp(6)
  completed_at    DateTime?                @db.Timestamp(6)
  last_error      String?                  @db.Text
  delivery        NotificationPushDelivery @relation(fields: [delivery_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([delivery_id, endpoint_hash], map: "index_push_device_attempts_on_delivery_endpoint")
  @@map("notification_push_device_attempts")
}

/// Active scopes are Post, Circle and Global; migration 20261030210000 enforces the SQL CHECK.
model NotificationPreference {
  id                Int      @id @default(autoincrement())
  user_id           Int      @map("user_id")
  scope_type        String   @default("Global") @map("scope_type") @db.VarChar
  scope_id          Int?     @map("scope_id")
  notification_type String   @default("all") @map("notification_type") @db.VarChar
  delivery_mode     String   @default("immediate") @map("delivery_mode") @db.VarChar
  push_enabled      Boolean  @default(true) @map("push_enabled")
  created_at        DateTime @map("created_at") @db.Timestamp(6)
  updated_at        DateTime @map("updated_at") @db.Timestamp(6)
  user              User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // NULL scope IDs are protected by the companion partial index in SQL.
  @@unique([user_id, scope_type, scope_id], map: "index_notification_preferences_on_user_scope")
  @@map("notification_preferences")
}

model EntryViewState {
  id                    Int       @id @default(autoincrement())
  user_id               Int       @map("user_id")
  entry_id              Int       @map("entry_id")
  entry_seen_at         DateTime? @map("entry_seen_at") @db.Timestamp(6)
  reply_seen_through_at DateTime? @map("reply_seen_through_at") @db.Timestamp(6)
  reply_seen_through_id Int?      @map("reply_seen_through_id")
  created_at            DateTime  @map("created_at") @db.Timestamp(6)
  updated_at            DateTime  @map("updated_at") @db.Timestamp(6)
  user                  User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  entry                 Entry     @relation(fields: [entry_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, entry_id], map: "index_entry_view_states_on_user_and_entry")
  @@index([user_id], map: "index_entry_view_states_on_user_id")
  @@index([entry_id], map: "index_entry_view_states_on_entry_id")
  @@map("entry_view_states")
}

model UserNoticeCursor {
  id              Int      @id @default(autoincrement())
  user_id         Int      @unique(map: "index_user_notice_cursors_on_user_id") @map("user_id")
  seen_through_at DateTime @map("seen_through_at") @db.Timestamp(6)
  created_at      DateTime @map("created_at") @db.Timestamp(6)
  updated_at      DateTime @map("updated_at") @db.Timestamp(6)
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_notice_cursors")
}

model PushSubscription {
  id         Int      @id @default(autoincrement())
  endpoint   String?  @db.VarChar
  p256dh     String?  @db.VarChar
  auth       String?  @db.VarChar
  subscribed Boolean? @default(false)
  created_at DateTime @map("created_at") @db.Timestamp(6)
  updated_at DateTime @map("updated_at") @db.Timestamp(6)
  user_id    Int?     @map("user_id")

  @@map("push_subscriptions")
}

model Role {
  id         Int      @id @default(autoincrement())
  user_id    Int      @map("user_id")
  name       String   @db.VarChar
  created_at DateTime @map("created_at") @db.Timestamp(6)
  updated_at DateTime @map("updated_at") @db.Timestamp(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("roles")
}

enum MediaProcessingKind {
  audio
  video
}

enum MediaProcessingState {
  processing
  published
  failed
  superseded
}

model MediaProcessingAttempt {
  id          String               @id @default(uuid()) @db.Uuid
  blob_id     Int
  generation  Int
  kind        MediaProcessingKind
  state       MediaProcessingState @default(processing)
  output_key  String               @unique
  error       String?
  created_at  DateTime             @default(now()) @db.Timestamptz(6)
  finished_at DateTime?            @db.Timestamptz(6)
  blob        ActiveStorageBlob    @relation(fields: [blob_id], references: [id], onDelete: Cascade)

  @@unique([blob_id, generation])
  @@index([state, created_at, id])
  @@map("media_processing_attempts")
}

model ActiveStorageBlob {
  media_source_key               String?
  media_generation               Int                          @default(0)
  media_processing_attempts      MediaProcessingAttempt[]
  id                             Int                          @id @default(autoincrement())
  key                            String                       @db.VarChar
  filename                       String                       @db.VarChar
  content_type                   String?                      @map("content_type") @db.VarChar
  metadata                       String?
  service_name                   String                       @map("service_name") @db.VarChar
  byte_size                      Int                          @map("byte_size")
  checksum                       String?                      @db.VarChar
  created_at                     DateTime                     @map("created_at") @db.Timestamp(6)
  active_storage_attachments     ActiveStorageAttachment[]
  active_storage_variant_records ActiveStorageVariantRecord[]
  audio_assets                   AudioAsset[]
  video_assets                   VideoAsset[]

  @@map("active_storage_blobs")
}

model ActiveStorageAttachment {
  id                   Int               @id @default(autoincrement())
  name                 String            @db.VarChar
  record_type          String            @map("record_type") @db.VarChar
  record_id            Int               @map("record_id")
  blob_id              Int               @map("blob_id")
  created_at           DateTime          @map("created_at") @db.Timestamp(6)
  active_storage_blobs ActiveStorageBlob @relation(fields: [blob_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([record_type, record_id, name, created_at, id], map: "index_attachments_on_identity_latest")
  @@map("active_storage_attachments")
}

model ActiveStorageVariantRecord {
  id                   Int               @id @default(autoincrement())
  blob_id              Int               @map("blob_id")
  variation_digest     String            @map("variation_digest") @db.VarChar
  active_storage_blobs ActiveStorageBlob @relation(fields: [blob_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("active_storage_variant_records")
}

model AudioAsset {
  id                 Int               @id @default(autoincrement())
  blob_id            Int               @map("blob_id")
  owner_id           Int               @map("owner_id")
  source_type        String            @map("source_type") @db.VarChar
  source_id          Int               @map("source_id")
  title              String            @db.VarChar
  original_filename  String            @map("original_filename") @db.VarChar
  original_mime_type String?           @map("original_mime_type") @db.VarChar
  processing_status  String            @map("processing_status") @db.VarChar
  duration_ms        Int?              @map("duration_ms")
  waveform_peaks     Json?             @map("waveform_peaks")
  error_message      String?           @map("error_message") @db.VarChar
  created_at         DateTime          @map("created_at") @db.Timestamp(6)
  updated_at         DateTime          @map("updated_at") @db.Timestamp(6)
  blob               ActiveStorageBlob @relation(fields: [blob_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  owner              User              @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  audio_annotations  AudioAnnotation[]

  @@index([source_type, source_id], map: "index_audio_assets_on_source")
  @@index([blob_id, id], map: "index_audio_assets_on_blob_id")
  @@index([processing_status, id, updated_at], map: "index_audio_assets_on_status_seek")
  @@map("audio_assets")
}

model VideoAsset {
  id                 Int               @id @default(autoincrement())
  blob_id            Int               @map("blob_id")
  owner_id           Int               @map("owner_id")
  source_type        String            @map("source_type") @db.VarChar
  source_id          Int               @map("source_id")
  title              String            @db.VarChar
  original_filename  String            @map("original_filename") @db.VarChar
  original_mime_type String?           @map("original_mime_type") @db.VarChar
  processing_status  String            @map("processing_status") @db.VarChar
  duration_ms        Int?              @map("duration_ms")
  width              Int?
  height             Int?
  error_message      String?           @map("error_message") @db.VarChar
  created_at         DateTime          @map("created_at") @db.Timestamp(6)
  updated_at         DateTime          @map("updated_at") @db.Timestamp(6)
  blob               ActiveStorageBlob @relation(fields: [blob_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  owner              User              @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([source_type, source_id], map: "index_video_assets_on_source")
  @@index([blob_id, id], map: "index_video_assets_on_blob_id")
  @@index([processing_status, id, updated_at], map: "index_video_assets_on_status_seek")
  @@map("video_assets")
}

model AudioAnnotation {
  id             Int        @id @default(autoincrement())
  audio_asset_id Int        @map("audio_asset_id")
  reply_id       Int        @map("reply_id")
  anchor_ms      Int        @map("anchor_ms")
  tolerance_ms   Int        @map("tolerance_ms")
  created_by_id  Int        @map("created_by_id")
  created_at     DateTime   @map("created_at") @db.Timestamp(6)
  audio_asset    AudioAsset @relation(fields: [audio_asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reply          Reply      @relation(fields: [reply_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  created_by     User       @relation("AudioAnnotationCreator", fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([audio_asset_id, anchor_ms], map: "index_audio_annotations_on_asset_and_anchor")
  @@map("audio_annotations")
}

model RoomVisit {
  room_id          Int
  user_id          Int
  source           String   @db.VarChar(16)
  last_activity_at DateTime @db.Timestamp(6)
  expires_at       DateTime @db.Timestamp(6)
  created_at       DateTime @default(now()) @db.Timestamp(6)
  room             Room     @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([room_id, user_id])
  @@index([expires_at])
  @@map("room_visits")
}

// Ephemeral process leases, not business history or job completion evidence.
model QueueWorkerHeartbeat {
  instance_id String   @id @db.Uuid
  seen_at     DateTime @db.Timestamp(6)

  @@index([seen_at])
  @@map("queue_worker_heartbeats")
}

// Connection keys are opaque, hashed, independently revocable and Project-scoped.
model AgentConnection {
  id String @id @default(uuid())
  user_id Int
  project_id Int
  name String @db.VarChar(80)
  token_hash String @unique @db.VarChar(64)
  reporting_consent Boolean @default(false)
  expires_at DateTime @db.Timestamp(6)
  revoked_at DateTime? @db.Timestamp(6)
  created_at DateTime @default(now()) @db.Timestamp(6)
  @@index([user_id, created_at])
  @@map("agent_connections")
}

// Retained after Entry deletion/move so monitoring cannot recreate the same source.
model AgentCaptureReceipt {
  id String @id @default(uuid())
  user_id Int
  project_id Int
  source_hash String @db.VarChar(64)
  entry_id Int?
  created_at DateTime @default(now()) @db.Timestamp(6)
  @@unique([user_id, project_id, source_hash])
  @@map("agent_capture_receipts")
}

model AgentCaptureOperation {
  id String @id @default(uuid())
  user_id Int
  operation_id String @db.VarChar(36)
  fingerprint String @db.VarChar(64)
  receipt_id String
  @@unique([user_id, operation_id])
  @@map("agent_capture_operations")
}
